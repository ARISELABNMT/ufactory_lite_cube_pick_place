<?xml version="1.0"?>
<model>
  <name>URXP Target Cube</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>ariselab</name>
  </author>
  <description>
    5cm cube for URXP color pick-and-place. Opposite face pairs are colored
    red (top/bottom), green (front/back +-X) and blue (left/right +-Y) so a
    single visible face always identifies the cube's color.
  </description>
</model>
